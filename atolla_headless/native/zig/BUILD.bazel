load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_static_library")
load("//atolla_app/native/zig:zig_ios_align.bzl", "zig_ios_align")

package(default_visibility = ["//visibility:public"])

# -lc: without libc, std.Thread.spawn takes zig's raw clone path, which aligns the new thread stack
# to linux.tls.area_desc. Only zig's own start code fills that in, and nothing runs it when the
# archive is linked into the Valdi C++ binary, so the alignment is zero and the spawn panics. With
# libc it spawns through pthreads instead. Darwin always links libSystem, so only linux hit this.
zig_binary(
    name = "dev_serve",
    srcs = [
        "api_version.zig",
        "bridge.zig",
        "command.zig",
        "credentials.zig",
        "hello.zig",
        "http_server.zig",
        "log.zig",
        "pair.zig",
        "problem.zig",
        "rate_limit.zig",
        "router.zig",
        "socket_reader.zig",
        "state.zig",
    ],
    main = "dev_serve.zig",
    zigopts = ["-lc"],
)

# -fcompiler-rt: std.Io has stack frames large enough that ReleaseSafe emits __zig_probe_stack
# calls, and bazel links this archive with clang/lld rather than zig, so nothing else supplies
# that symbol. Only x86_64 is affected.
zig_static_library(
    name = "atolla_headless_zig",
    srcs = [
        "api_version.zig",
        "bridge.zig",
        "command.zig",
        "credentials.zig",
        "hello.zig",
        "http_server.zig",
        "log.zig",
        "pair.zig",
        "problem.zig",
        "random_bytes.zig",
        "rate_limit.zig",
        "router.zig",
        "socket_reader.zig",
        "state.zig",
    ],
    main = "atolla_headless.zig",
    zigopts = [
        "-fPIC",
        "-fcompiler-rt",
        "-lc",
    ],
)

zig_ios_align(
    name = "atolla_headless_zig_apple",
    zig_lib = ":atolla_headless_zig",
)

cc_library(
    name = "http_server",
    hdrs = ["http_server.h"],
    includes = ["."],
    deps = select({
        "@platforms//os:macos": [":atolla_headless_zig_apple"],
        "//conditions:default": [":atolla_headless_zig"],
    }),
)

# alwayslink: the module registers itself through a static initialiser, which the linker would
# otherwise drop because nothing references it.
cc_library(
    name = "http_module",
    srcs = select({
        "@valdi//bzl/conditions:linux": ["AtollaHttpModuleFactory.cpp"],
        "@valdi//bzl/conditions:macos": ["AtollaHttpModuleFactory.cpp"],
        "//conditions:default": [],
    }),
    deps = [
        ":http_server",
        "@valdi//valdi_core",
    ],
    alwayslink = 1,
)

cc_library(
    name = "random_bytes",
    hdrs = ["random_bytes.h"],
    includes = ["."],
    deps = select({
        "@platforms//os:macos": [":atolla_headless_zig_apple"],
        "//conditions:default": [":atolla_headless_zig"],
    }),
)

# alwayslink: the module registers itself through a static initialiser, which the linker would
# otherwise drop because nothing references it.
cc_library(
    name = "random_module",
    srcs = select({
        "@valdi//bzl/conditions:linux": ["AtollaRandomModuleFactory.cpp"],
        "@valdi//bzl/conditions:macos": ["AtollaRandomModuleFactory.cpp"],
        "//conditions:default": [],
    }),
    deps = [
        ":random_bytes",
        "@valdi//valdi_core",
    ],
    alwayslink = 1,
)
