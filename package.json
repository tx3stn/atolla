{
	"dependencies": {},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@snap/valdi": "^1.1.7",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.0",
		"@wdio/appium-service": "^9.31.4",
		"@wdio/cli": "^9.31.4",
		"@wdio/globals": "^9.31.3",
		"@wdio/local-runner": "^9.31.4",
		"@wdio/mocha-framework": "^9.31.2",
		"@wdio/spec-reporter": "^9.31.2",
		"appium": "^3.7.0",
		"appium-inspector-plugin": "^2026.7.1",
		"appium-uiautomator2-driver": "^8.5.0",
		"appium-xcuitest-driver": "^12.7.0",
		"fast-check": "^4.9.0",
		"lefthook": "^2.1.12",
		"sharp": "^0.35.4",
		"typescript": "^7.0.2",
		"webdriverio": "^9.31.4"
	},
	"name": "atolla",
	"overrides": {
		"fast-uri": "^3.1.5",
		"js-yaml": "^4.3.1",
		"serialize-javascript": "^7.0.7"
	},
	"private": true,
	"scripts": {
		"adb:reload": "adb shell am force-stop com.tx3stn.atolla && adb shell monkey -p com.tx3stn.atolla -c android.intent.category.LAUNCHER 1",
		"android": "./.scripts/build-and-run-android.sh",
		"android:tablet": "AVD_NAME=gsd-tablet-api34 bun run android",
		"appium:inspect": "./.scripts/start-appium-inspector.sh",
		"build:apk": "./.scripts/build-android-apk.sh",
		"build:headless": "./.scripts/build-headless.sh",
		"build:headless:arm64": "./.scripts/build-headless.sh arm64",
		"build:ipa": "./.scripts/build-ios-ipa.sh",
		"check": "bunx lefthook run pre-push --all-files",
		"check:bazel": "bun run check:zig && bun run test:zig && bun run test:android && bun run test:ios",
		"check:full": "./.scripts/check-full.sh",
		"check:static": "bun run format && bun run lint && bun run compile && bun run test && bun run format:zig",
		"check:zig": "bazel build //atolla_app/native/zig:atolla_algorithms_zig //atolla_headless/native/zig:atolla_headless_zig //:valdi_editor_anchor",
		"compile": "bazel build //:valdi_editor_anchor && bunx tsc --noEmit -p tsconfig.json && bunx tsc --noEmit -p atolla_core/tsconfig.src.json && bunx tsc --noEmit -p atolla_core/tsconfig.tests.json && bunx tsc --noEmit -p atolla_jellyfin/tsconfig.src.json && bunx tsc --noEmit -p atolla_jellyfin/tsconfig.tests.json && bunx tsc --noEmit -p atolla_player/tsconfig.src.json && bunx tsc --noEmit -p atolla_player/tsconfig.tests.json && bunx tsc --noEmit -p atolla_app/tsconfig.src.json && bunx tsc --noEmit -p atolla_app/tsconfig.tests.json && bunx tsc --noEmit -p atolla_headless/tsconfig.src.json && bunx tsc --noEmit -p atolla_headless/tsconfig.tests.json",
		"format": "biome format --write .",
		"format:zig": "zig fmt ./atolla_app/native/zig/ ./atolla_headless/native/zig/",
		"icons:generate": "bun ./.scripts/generate-icons.ts",
		"icons:palette": "bun ./.scripts/generate-palette.ts",
		"ios": "./.scripts/build-and-run-ios.sh",
		"ios:tablet": "SIMULATOR_NAME='iPad Pro 11-inch (M5)' bun run ios",
		"lint": "biome check --write --assist-enabled=true --enforce-assist=true --unsafe .",
		"linux": "./.scripts/run-headless.sh",
		"mobsf": "docker run --rm -v $(pwd):/src opensecurity/mobsfscan /src --config /src/.mobsf.yaml",
		"mobsf:ui": "docker run -it --rm -p 8000:8000 opensecurity/mobile-security-framework-mobsf:latest",
		"mock:generate": "bun tools/mock-server/generate.ts",
		"mock:serve": "bun tools/mock-server/serve.ts",
		"palette:preview": "bun ./tools/palette-preview/run.ts",
		"projectsync": "bunx valdi projectsync --target //atolla_core:atolla_core_projectsync --target //atolla_jellyfin:atolla_jellyfin_projectsync --target //atolla_player:atolla_player_projectsync --target //atolla_app:atolla_app_projectsync --target //atolla_headless:atolla_headless_projectsync",
		"projectsync:all": "bun run projectsync --target //atolla_app_dev:atolla_app_dev_projectsync --target //tools/palette-preview:palette-preview_projectsync",
		"rebuild:android": "bun run check && bun run test:components && bun run android",
		"rebuild:ios": "bun run check && bun run test:components && bun run ios",
		"reload": "./.scripts/android-hotreload.sh",
		"screenshots": "E2E_PLATFORM=iOS E2E_APP_PATH=$PWD/build/atolla_ios.ipa wdio run ./e2e/app/screenshots/wdio.conf.ts",
		"screenshots:combine": "bun ./.scripts/combine-screenshots.ts",
		"setup": "bun install && bun run projectsync:all",
		"start:e2e-devices": "./.scripts/start-e2e-devices.sh",
		"test": "bun test ./atolla_core/src ./atolla_jellyfin/src ./atolla_player/src ./atolla_app/src ./atolla_headless/src",
		"test:android": "bazel test //atolla_app/native/android/test/... //:valdi_editor_anchor --legacy_external_runfiles --test_output=streamed --test_summary=short --noshow_loading_progress --show_result=0 --test_verbose_timeout_warnings",
		"test:components": "bazel test //atolla_app:test --test_output=streamed --test_summary=short --noshow_loading_progress --show_result=0 --test_verbose_timeout_warnings",
		"test:e2e": "./.scripts/test-e2e-parallel.sh",
		"test:e2e:android": "E2E_APP_PATH=$PWD/build/atolla_android.apk wdio run ./e2e/app/wdio.conf.ts",
		"test:e2e:android:tablet": "E2E_FORM_FACTOR=tablet bun run test:e2e:android",
		"test:e2e:cli": "bun --cwd=e2e/cli test --timeout=30000",
		"test:e2e:ios": "E2E_PLATFORM=iOS E2E_APP_PATH=$PWD/build/atolla_ios.ipa wdio run ./e2e/app/wdio.conf.ts",
		"test:e2e:ios:tablet": "E2E_FORM_FACTOR=tablet bun run test:e2e:ios",
		"test:e2e:smoke": "E2E_ANDROID_APP_PATH=$PWD/build/atolla_android.apk E2E_IOS_APP_PATH=$PWD/build/atolla_ios.ipa wdio run ./e2e/app/wdio.conf.parallel.ts --spec e2e/app/tests/smoke",
		"test:ios": "bazel test //atolla_app/native/ios/test/... //:valdi_editor_anchor --test_output=streamed --test_summary=short --noshow_loading_progress --show_result=0 --test_verbose_timeout_warnings",
		"test:zig": "./.scripts/test-zig.sh"
	},
	"version": "0.0.0"
}
